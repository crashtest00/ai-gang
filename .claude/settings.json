{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/pr-cleanup.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-worktree.sh\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
