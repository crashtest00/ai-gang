# AI Gang HQ — Environment Template
#
# Copy this file to .env and fill in the values:
#   cp .env.template .env
#
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# WARNING: NEVER enter real values in this file.
#          .env.template is committed to git. .env is not.
#          All secrets go in .env only.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

# --- Jira ---
# Your Jira Cloud instance URL (no trailing slash)
JIRA_URL=https://your-org.atlassian.net

# The email address associated with your Jira account
JIRA_EMAIL=you@example.com

# Jira API token — generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# --- Anthropic ---
# API key — generate at https://console.anthropic.com/settings/keys
# Copied automatically into each project's .env by init-project.sh
ANTHROPIC_API_KEY=

# --- GitHub (Jenkins) ---
# Fine-grained PAT for Jenkins. Today this is the *same* token value as each
# project's own GH_TOKEN, not a separate least-privilege credential — copy
# this value into a project's GH_TOKEN when running init-project.sh, since
# jenkins.yaml only ever wires up one GitHub credential globally (see
# docs/UserGuide.md: "The same token is used by FE/BE agents ... and by
# Jenkins"). Needs, at minimum:
#   - Commit statuses: Read and write (so PR status checks show up)
#   - Whichever repo scope you want Jenkins watching (all repos, or a
#     specific org/repo list)
# See this file's "GitHub" prerequisites section for the full set of scopes
# Jenkins actually uses (Pull requests, Actions, Contents are also needed
# for auto-merge, build-desktop dispatch, and release-tag pushes).
# Used as: username x-access-token, this token as the password — already
# wired up that way in jenkins/jenkins.yaml, nothing to configure there.
GITHUB_TOKEN=

# GitHub username behind the GITHUB_TOKEN/github-token credential above —
# i.e. whichever account Jenkins' PAT belongs to. Required before running
# ./scripts/init-project.sh: without it, 'beta'/'prod' branch protection is
# skipped with a warning (an incomplete restrictions.users list would
# otherwise lock out every pusher, including Jenkins itself). See
# setup/JenkinsConfig.md §7.
JENKINS_GITHUB_USER=

# --- Cloudflare Tunnel ---
# API token — go to https://dash.cloudflare.com/profile/api-tokens
# → Create Token → use the "Edit zone DNS" template
# → Scope it to the specific zone (domain) you'll use
# This needs Zone / DNS / Edit, not Read — setup-cloudflare-tunnel.sh creates
# and updates CNAME records via the API, which Read-only access will reject.
# The "Edit zone DNS" template already sets this correctly; only worth
# double-checking if you build a custom token instead of using the template.
#
# If you will also set PREVIEW_SUBDOMAIN or BETA_DOMAIN below (enables
# Cloudflare Access), add Account / Access: Apps and Policies / Edit to the
# same token — the DNS template alone does not cover it, and Access
# application creation fails without it.
CF_API_KEY=

# Zone ID — found on the Cloudflare dashboard overview page for your domain
# (right sidebar, scroll down to "Zone ID")
CF_ZONE_ID=

# Account ID — found on the same Cloudflare dashboard overview page (right
# sidebar). Only required if you set PREVIEW_SUBDOMAIN or BETA_DOMAIN below —
# used for the Access-application API calls that gate those hostnames.
CF_ACCOUNT_ID=

# Subdomain that will serve as the public HTTPS entry point for ScrumMaster
# Must be within the zone above. setup-cloudflare-tunnel.sh will create the DNS record.
HQ_SUBDOMAIN=aigang.yourdomain.com

# Subdomain for Jenkins — a separate public hostname from HQ_SUBDOMAIN, since
# GitHub's webhooks call Jenkins directly (not proxied through ScrumMaster).
# Must be within the zone above.
JENKINS_SUBDOMAIN=jenkins.yourdomain.com

# --- Beta VM (optional — only if this project has a release-candidate
# preview or long-lived beta-app flow; see beta-vm/README.md) ---
# Wildcard hostname for release-candidate previews, e.g. *.preview.yourdomain.com
PREVIEW_SUBDOMAIN=

# Long-lived per-project beta-app hostname, e.g. beta.yourdomain.com
BETA_DOMAIN=

# Beta VM's LAN/VPC IP or hostname. Required if PREVIEW_SUBDOMAIN or
# BETA_DOMAIN is set — setup-cloudflare-tunnel.sh runs on the Dev VM, so
# Traefik on the Beta VM must be reached over the network, not localhost.
BETA_VM_HOST=

# Your existing sudo-capable SSH user on the Beta VM, used once by
# setup-beta-vm.sh to bootstrap the unprivileged beta-deploy account.
BETA_VM_ADMIN_USER=

# Port Traefik listens on for the Beta VM. Optional, defaults to 8181.
BETA_VM_TRAEFIK_PORT=8181

# --- ScrumMaster ---
# Set automatically by setup-cloudflare-tunnel.sh after the tunnel is live.
# Format: https://<HQ_SUBDOMAIN>
# Do not set this manually unless you know what you're doing.
HQ_URL=

# --- Jenkins ---
# Set automatically by setup-cloudflare-tunnel.sh after the tunnel is live.
# Format: https://<JENKINS_SUBDOMAIN>
# Do not set this manually unless you know what you're doing.
JENKINS_URL=

# Auto-generated by init-jenkins.sh if left blank — leave empty unless you
# have a specific password you need Jenkins' admin account to use.
JENKINS_ADMIN_PASSWORD=

# --- Beta VM (auto-set) ---
# Set automatically by setup-cloudflare-tunnel.sh from PREVIEW_SUBDOMAIN
# (the bare domain, "*." stripped) — consumed by setup-beta-vm.sh.
# Do not set this manually unless you know what you're doing.
PREVIEW_DOMAIN=
