# Jira credentials — use a dedicated service account, NOT a personal account
# See SETUP_CHECKLIST.md Phase 1.0 for setup instructions.
# Atlassian API tokens have no scope selection; the service account's project role controls access.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=ai-gang-bot@your-domain.com
JIRA_API_TOKEN=

# Jira custom field IDs — populated automatically by scripts/create-jira-fields.sh
JIRA_AGENT_FIELD_ID=customfield_XXXXX
JIRA_BLOCKED_FIELD_ID=customfield_XXXXX

# Story schema fields (paragraph type) — also set by create-jira-fields.sh
JIRA_VALUE_HYPOTHESIS_FIELD_ID=customfield_XXXXX
JIRA_TEST_MEASUREMENT_FIELD_ID=customfield_XXXXX
JIRA_BEHAVIOR_FIELD_ID=customfield_XXXXX
JIRA_AC_FIELD_ID=customfield_XXXXX
JIRA_CONSTRAINTS_FIELD_ID=customfield_XXXXX
JIRA_EDGE_CASES_FIELD_ID=customfield_XXXXX
JIRA_OUT_OF_SCOPE_FIELD_ID=customfield_XXXXX

# Release ticket fields — populated by scripts/create-release-fields.sh.
# These track a release candidate through Jira: target project, release
# notes, candidate SHA, build identifier, and preview URL.
JIRA_TARGET_PROJECT_FIELD_ID=customfield_XXXXX
JIRA_RELEASE_NOTES_FIELD_ID=customfield_XXXXX
JIRA_CANDIDATE_SHA_FIELD_ID=customfield_XXXXX
JIRA_BUILD_IDENTIFIER_FIELD_ID=customfield_XXXXX
JIRA_PREVIEW_URL_FIELD_ID=customfield_XXXXX

# Wildcard hostname for ephemeral release-candidate previews, e.g. preview.yourdomain.com
# (containers are addressed as rc-<sha>.<PREVIEW_DOMAIN>). See setup-cloudflare-tunnel.sh.
PREVIEW_DOMAIN=

# Jira issue-link-type id whose outward relationship is "blocks" / inward is
# "is blocked by" — used for dependency links.
# Optional: if unset, ScrumMaster discovers Jira's built-in "Blocks" link type
# by name once at startup and caches its id. Set this explicitly if your
# instance's default link type was renamed or removed.
# Look it up with: curl -u $JIRA_USER_EMAIL:$JIRA_API_TOKEN $JIRA_BASE_URL/rest/api/3/issueLinkType
JIRA_BLOCKS_LINK_TYPE_ID=

# Redis connection (overridden in docker-compose.yml for container networking)
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis Streams retention
STREAM_RETENTION_DAYS=7
DEAD_LETTER_RETENTION_DAYS=30

# Shared secret for validating inbound Jira webhooks.
# Auto-generated by init-project.sh if not set; embedded in the webhook URL as ?secret=<value>.
WEBHOOK_SECRET=

# Paths (baked into the image at build time — see Dockerfile's COPY . .)
# AGENTS_CATALOG_PATH is the canonical agent catalog.
# PROJECTS_CONFIG_PATH is each project's effective allowed-agent subset of that catalog.
AGENTS_CATALOG_PATH=/app/config/agents.json
PROJECTS_CONFIG_PATH=/app/config/projects.json
PROJECTS_BASE_PATH=/projects

# HTTP port for webhook receiver
PORT=9000

# Jenkins base URL — written to ~/ai-gang/.env by init-jenkins.sh.
# Used to trigger the release-flow jobs (release-candidate, production-promote,
# release-preview-teardown) via Generic Webhook Trigger. dev → beta promotion
# no longer goes through ScrumMaster — it's automatic, inside each project's
# own Jenkinsfile, on every merge to `dev`. See JenkinsConfig.md §6.
JENKINS_URL=
