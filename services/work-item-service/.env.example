# AI Gang Internal Work-Item Service — environment file.
#
# Platform startup generates this file for you: scripts/startup/derive-env.sh
# writes it from the repository-root .env on every run, and overwrites
# anything you change here. Edit the root .env instead. This example is
# the reference for what the service reads and what each value does.
#
# Docker Compose reads this same file twice — as these services' env_file,
# and as the interpolation source for the ${PGUSER}/${PGPASSWORD}/${PGDATABASE}
# references in docker-compose.yml.
#
# Every variable below is read by workitemservice/settings.py, except the
# Jira custom field IDs, which workitems/jira_interpret.py and
# workitems/webhook_consumer.py read directly via os.environ.

# --- PostgreSQL ---
# Host and port of this service's own database. The host matches the
# postgres service's container name in docker-compose.yml.
PGHOST=workitem-postgres
PGPORT=5432
PGUSER=workitem
PGPASSWORD=
PGDATABASE=workitem

# A single connection string, if you prefer one. Set, it wins over the
# five PG* variables above.
# DATABASE_URL=

# --- Django ---
# Secret key for this installation. Invent one: openssl rand -hex 24
DJANGO_SECRET_KEY=

# Leave DEBUG off outside development.
# DJANGO_DEBUG=false

# Comma-separated Host header allow-list. Defaults to * .
# DJANGO_ALLOWED_HOSTS=*

# --- Redis ---
# The Streams command channel, event stream and webhook consumers. The
# host matches Redis's container name in services/redis/docker-compose.yml.
REDIS_HOST=ai-gang-redis
REDIS_PORT=6379
# A single Redis URL, if you prefer one. Set, it wins over REDIS_HOST/PORT.
# REDIS_URL=

# --- Catalogs ---
# The same on-disk agent catalog and per-project agent configuration
# ScrumMaster reads, mounted read-only at /app/config by docker-compose.yml.
# AGENTS_CATALOG_PATH=/app/config/agents.json
# PROJECTS_CONFIG_PATH=/app/config/projects.json

# --- HTTP ---
# The port gunicorn binds inside the container; docker-compose.yml
# publishes it on 127.0.0.1:9100.
PORT=9100

# --- Consumers and relay ---
# Consumer identity, defaulting to the container's hostname.
# WORKITEM_CONSUMER_ID=
# Outbox relay polling.
# RELAY_POLL_INTERVAL_MS=1000
# RELAY_BATCH_SIZE=20
# Test-only: milliseconds to sleep per relayed row. Zero in every
# deployment; see workitems/relay.py.
# RELAY_ROW_DELAY_MS=0

# --- Jira custom field IDs ---
# Optional in local mode: only needed when this project's work items are
# managed through Jira. Reuses the SAME env var names
# services/scrummaster/src/jira.js reads, so one platform .env configures
# both services' custom-field ids identically —
# scripts/startup/derive-env.sh copies whichever of these are set in the
# platform .env into this file; an unset one is left out entirely rather
# than written empty.
# The Agent field (assignment) and the Blocked field ("Blocked cleared"
# detection) — populated by scripts/create-jira-fields.sh.
# JIRA_AGENT_FIELD_ID=
# JIRA_BLOCKED_FIELD_ID=
# Story schema fields (paragraph type) — populated by scripts/create-jira-fields.sh.
# JIRA_VALUE_HYPOTHESIS_FIELD_ID=
# JIRA_TEST_MEASUREMENT_FIELD_ID=
# JIRA_BEHAVIOR_FIELD_ID=
# JIRA_AC_FIELD_ID=
# JIRA_CONSTRAINTS_FIELD_ID=
# JIRA_EDGE_CASES_FIELD_ID=
# JIRA_OUT_OF_SCOPE_FIELD_ID=
# Release ticket fields (BUGFIXES.md BF-01) — populated by scripts/create-release-fields.sh.
# JIRA_TARGET_PROJECT_FIELD_ID=
# JIRA_RELEASE_NOTES_FIELD_ID=
# JIRA_CANDIDATE_SHA_FIELD_ID=
# JIRA_BUILD_IDENTIFIER_FIELD_ID=
# JIRA_PREVIEW_URL_FIELD_ID=

# --- Artifact ingress ---
# Root of the mounted volume holding artifact files — the only
# authoritative copy of an artifact's bytes (artifacts/README.md).
# Defaults to the named volume path docker-compose.yml mounts.
# ARTIFACT_ROOT=/var/lib/aigang/artifacts

# --- Librarian ---
# Root of the mounted projects directory; every project is one directory
# directly under it, but the repository itself is that project directory's
# PROJECTS_REPO_SUBDIR working tree, not the project directory (librarian/README.md).
# PROJECTS_ROOT=/var/lib/aigang/projects
# The subdirectory of a project directory that IS the git working tree
# (and the requesting agent's /workspace). Compose default: src.
# PROJECTS_REPO_SUBDIR=src
# Test-only: milliseconds the librarian sleeps while holding its
# per-(artifact, repository) advisory lock. Zero in every deployment.
# LIBRARIAN_LOCK_HOLD_DELAY_MS=0
